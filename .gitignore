.robot_dh/

# ---- secrets / credentials (NEVER commit) ----
# k8s secret with real credentials
k8s/secret.yaml
k8s/*-secret.yaml
!k8s/*-secret.example.yaml

# client env / shell scripts that may embed real passwords
client/wsl-export-*.sh
client/*.env
!client/*.env.example

# v1.4 lake assets (cloud handoff artifacts that may carry secrets/internal info)
client/k8s-lake-secret.yaml
client/k8s-create-lake-secret.sh
!client/k8s-lake-secret.example.yaml
!client/k8s-create-lake-secret.example.sh

# remote asset inventory snapshots (internal layout / object lists)
docs/remote_assets_*.json
client/remote_assets_*.json

# personal handoff cache (real-password env lives outside repo anyway,
# but if someone drops a copy here we still want it ignored)
.handoff_cache/

.cursor/

# Go exporter build artifacts
go/robot-dh-exporter/bin/
go/robot-dh-exporter/vendor/

exyzxyzw/
eexyzxyzw/

# v1.6 实跑工件：archiveLogs dump / fhkvr-bundle / 调试目录，禁止入 git
log_robot-dh-*/
robot-dh-*-bundle/
test_debug/

# ---- platform secret 模板防护（仅 example 入 git）----
# 真实凭据 env：禁止入 git
client/robot-dh-platform.env
# 真实 secret yaml：禁止入 git，但 example 模板允许
client/k8s-platform-secret.yaml
client/k8s-create-platform-secret.sh