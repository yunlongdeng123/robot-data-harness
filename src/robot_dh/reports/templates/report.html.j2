<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>robot-data-harness report</title>
    <style>
      :root {
        --bg: #f6f2eb;
        --panel: #fffdf8;
        --ink: #1b2631;
        --muted: #51606d;
        --line: #d7cfc3;
        --pass: #2a9d8f;
        --warn: #f4a261;
        --fail: #c1121f;
        --accent: #0f4c5c;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: radial-gradient(circle at top left, #fef7eb, var(--bg));
        color: var(--ink);
        font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      }
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }
      .hero {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 12px 32px rgba(15, 76, 92, 0.08);
      }
      h1, h2, h3 {
        margin: 0 0 12px;
        font-weight: 700;
      }
      h1 {
        font-size: 30px;
        letter-spacing: -0.02em;
      }
      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 14px;
        font-weight: 700;
      }
      .status-pass {
        color: var(--pass);
        background: rgba(42, 157, 143, 0.12);
      }
      .status-warn {
        color: var(--warn);
        background: rgba(244, 162, 97, 0.14);
      }
      .status-fail {
        color: var(--fail);
        background: rgba(193, 18, 31, 0.12);
      }
      .meta-grid,
      .metric-grid,
      .plots-grid {
        display: grid;
        gap: 16px;
      }
      .meta-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .metric-grid {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }
      .metric {
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 14px;
        background: rgba(255, 255, 255, 0.7);
      }
      .metric .label {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 6px;
      }
      .metric .value {
        font-size: 22px;
        font-weight: 700;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }
      th,
      td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      th {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .plots-grid {
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      }
      .plot-card img {
        width: 100%;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: #fff;
      }
      ul {
        margin: 0;
        padding-left: 18px;
      }
      code {
        font-family: "IBM Plex Mono", "SFMono-Regular", monospace;
      }
      @media (max-width: 860px) {
        .hero {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="card">
          <h1>robot-data-harness</h1>
          <p>Robot Data Quality &amp; Evaluation report for eexyzxyzw trajectory validation.</p>
          <div class="meta-grid">
            <div>
              <div class="label">Run ID</div>
              <div><code>{{ report.run_id }}</code></div>
            </div>
            <div>
              <div class="label">Dataset ID</div>
              <div><code>{{ report.dataset_id }}</code></div>
            </div>
            <div>
              <div class="label">Started</div>
              <div>{{ report.started_at }}</div>
            </div>
            <div>
              <div class="label">Finished</div>
              <div>{{ report.finished_at }}</div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="status-badge status-{{ report.status|lower }}">{{ report.status }}</div>
          <p><strong>Duration:</strong> {{ "%.3f"|format(report.duration_sec) }} s</p>
          <p><strong>Warnings:</strong> {{ report.warnings|length }}</p>
          <p><strong>Errors:</strong> {{ report.errors|length }}</p>
        </div>
      </section>

      <section class="card">
        <h2>Key Metrics</h2>
        <div class="metric-grid">
          {% for key, value in report.metrics.items() %}
          <div class="metric">
            <div class="label">{{ key }}</div>
            <div class="value">{{ value }}</div>
          </div>
          {% endfor %}
        </div>
      </section>

      <section class="card">
        <h2>Validator Summary</h2>
        <table>
          <thead>
            <tr>
              <th>Validator</th>
              <th>Status</th>
              <th>Messages</th>
            </tr>
          </thead>
          <tbody>
            {% for validator in report.validators %}
            <tr>
              <td><code>{{ validator.name }}</code></td>
              <td>
                <span class="status-badge status-{{ validator.status|lower }}">{{ validator.status }}</span>
              </td>
              <td>
                <ul>
                  {% for message in validator.messages %}
                  <li>{{ message }}</li>
                  {% endfor %}
                </ul>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card">
        <h2>Warnings / Errors</h2>
        <table>
          <thead>
            <tr>
              <th>Warnings</th>
              <th>Errors</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <ul>
                  {% if report.warnings %}
                    {% for warning in report.warnings %}
                    <li>{{ warning }}</li>
                    {% endfor %}
                  {% else %}
                    <li>None</li>
                  {% endif %}
                </ul>
              </td>
              <td>
                <ul>
                  {% if report.errors %}
                    {% for error in report.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                  {% else %}
                    <li>None</li>
                  {% endif %}
                </ul>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="card">
        <h2>Plots</h2>
        <div class="plots-grid">
          {% for title, path in plot_cards %}
          <div class="plot-card">
            <h3>{{ title }}</h3>
            <img src="{{ path }}" alt="{{ title }}" />
          </div>
          {% endfor %}
        </div>
      </section>

      <section class="card">
        <h2>Cluster Centers</h2>
        <table>
          <thead>
            <tr>
              <th>Cluster</th>
              <th>Center X</th>
              <th>Center Y</th>
              <th>Count</th>
              <th>Radius</th>
            </tr>
          </thead>
          <tbody>
            {% if cluster_centers %}
              {% for row in cluster_centers %}
              <tr>
                <td>{{ row.index }}</td>
                <td>{{ row.center_x }}</td>
                <td>{{ row.center_y }}</td>
                <td>{{ row.count }}</td>
                <td>{{ row.radius }}</td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="5">No cluster data</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </section>

      <section class="card">
        <h2>Jump Points</h2>
        <table>
          <thead>
            <tr>
              <th>Index</th>
              <th>Time (s)</th>
            </tr>
          </thead>
          <tbody>
            {% if jump_points %}
              {% for row in jump_points %}
              <tr>
                <td>{{ row.index }}</td>
                <td>{{ row.time_sec }}</td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="2">No jump points</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
