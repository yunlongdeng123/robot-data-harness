# robot-dh-lake.env.example
#
# v1.4 数据湖客户端环境变量模板。
# 请勿提交真实密码版本。权威的真实密码文件位于
# ~/.config/robot-dh/robot-dh-lake.env（权限 0600）。
#
# 2026-05-21 在接收端（WSL）重建：因本地代理 TUN 导致 SSH 至
# robot-dh-infra 受阻；此处各键经直连服务探测校验（PG/MinIO/Redis 均为 PASS）。
# SSH 恢复后，请用权威版本替换:
#   /opt/robot-dh-infra/client/robot-dh-lake.env.example

# --- PostgreSQL ---
# 应用角色: robot_dh_app。数据库: robot_dh。
# SSH 隧道模式请使用回环地址 127.0.0.1:15432。
ROBOT_DH_DB_URI=postgresql+psycopg://robot_dh_app:CHANGE_ME@PUBLIC_SERVER_IP_OR_DNS:5432/robot_dh

# --- 产物存储后端选择 ---
# v1.4 数据湖路径须为 "s3"。"local" 保持 v1.3 文件系统模式。
ROBOT_DH_ARTIFACT_STORE=s3

# --- MinIO（S3 兼容）---
# SSH 隧道模式请使用 http://127.0.0.1:19000。
ROBOT_DH_S3_ENDPOINT_URL=http://PUBLIC_SERVER_IP_OR_DNS:9000
ROBOT_DH_S3_ACCESS_KEY=robotdhapp
ROBOT_DH_S3_SECRET_KEY=CHANGE_ME
ROBOT_DH_S3_REGION=us-east-1

# v1.3 桶（读写）:
ROBOT_DH_S3_DATA_BUCKET=robot-datasets
ROBOT_DH_S3_ARTIFACT_BUCKET=robot-dh-artifacts

# v1.4 数据湖桶（读写；raw 层实际为仅追加）:
ROBOT_DH_S3_LAKE_BUCKET=robot-lake

# --- Redis ---
# SSH 隧道模式请使用 redis://:CHANGE_ME@127.0.0.1:16379/0。
ROBOT_DH_REDIS_URL=redis://:CHANGE_ME@PUBLIC_SERVER_IP_OR_DNS:6379/0
