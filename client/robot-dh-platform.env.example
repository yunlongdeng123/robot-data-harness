# robot-dh v1.6 client env 模板。
#
# 用法：
#   - 这个 .example 文件可以提交到 git，里面只放占位符。
#   - 真实凭据由 ./scripts/41_export_platform_client_env.sh --show-secrets
#     生成到 client/robot-dh-platform.env（chmod 600，**不要**提交到 git）。
#   - kind / Argo Pod 不能用 WSL 127.0.0.1 SSH tunnel，必须使用云端公网 IP/DNS。

# 版本 / namespace 标识
ROBOT_DH_PLATFORM_VERSION=1.6
ROBOT_DH_RELEASE_VERSION=v1.6
ROBOT_DH_ARGO_NAMESPACE=robot-dh

# PostgreSQL：应用账号，覆盖 v1.3~v1.6 全部业务表
ROBOT_DH_DB_URI=postgresql+psycopg://robot_dh_app:CHANGE_ME_APP_PASSWORD@PUBLIC_SERVER_IP_OR_DNS:5432/robot_dh

# MinIO：S3 兼容协议
ROBOT_DH_ARTIFACT_STORE=s3
ROBOT_DH_S3_ENDPOINT_URL=http://PUBLIC_SERVER_IP_OR_DNS:9000
ROBOT_DH_S3_REGION=us-east-1
ROBOT_DH_S3_ACCESS_KEY=robotdhapp
ROBOT_DH_S3_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET

# v1.3 / v1.4 bucket
ROBOT_DH_S3_DATA_BUCKET=robot-datasets
ROBOT_DH_S3_ARTIFACT_BUCKET=robot-dh-artifacts
ROBOT_DH_S3_BACKUP_BUCKET=robot-dh-backups
ROBOT_DH_S3_LAKE_BUCKET=robot-lake

# Redis：事件总线 / 任务队列
ROBOT_DH_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@PUBLIC_SERVER_IP_OR_DNS:6379/0

# v1.6 新增：QC contract / ML-ready / workflow tmp 根前缀
ROBOT_DH_QC_CONTRACT_BUCKET_PREFIX=s3://robot-lake/qc
ROBOT_DH_ML_READY_ROOT=s3://robot-lake/ml-ready
ROBOT_DH_WORKFLOW_TMP_PREFIX=s3://robot-lake/tmp/workflows
