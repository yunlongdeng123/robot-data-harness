# AutoDL 推理 worker 环境变量示例。
#
# 用法：
#   cp config.example.env config.env   # 填真实值，不要提交 git
#   set -a; source config.env; set +a
#   ./run_worker.sh --dry-run --max-jobs 1
#
# 说明：worker 只需"出站"连接腾讯云 PG / MinIO + 本机 vLLM endpoint，
# 不需要任何入站端口，不在 AutoDL 上跑 K8s / Docker / DB。

# 腾讯云 PostgreSQL（拉取 / 回写 inference_jobs）
ROBOT_DH_DB_URI=postgresql+psycopg://robot_dh_app:CHANGE_ME_APP_PASSWORD@PUBLIC_SERVER_IP_OR_DNS:5432/robot_dh

# 腾讯云 MinIO（predictions 写回；input 读取）
ROBOT_DH_S3_ENDPOINT_URL=http://PUBLIC_SERVER_IP_OR_DNS:9000
ROBOT_DH_S3_REGION=us-east-1
ROBOT_DH_S3_ACCESS_KEY=robotdhapp
ROBOT_DH_S3_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET
ROBOT_DH_S3_LAKE_BUCKET=robot-lake

# 本机 vLLM / OpenAI-compatible endpoint（在同一 AutoDL 容器内 run_vllm_example.sh 起）
ROBOT_DH_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
ROBOT_DH_OPENAI_COMPATIBLE_API_KEY=
ROBOT_DH_OPENAI_COMPATIBLE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# worker 默认处理的模型（也可用 --model-id 覆盖）
ROBOT_DH_WORKER_MODEL_ID=openai-compatible-chat-v1
